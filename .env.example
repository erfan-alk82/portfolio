# Public origin of the site. Required for production builds; used for
# canonical URLs, hreflang, the sitemap and social images.
SITE_URL=https://erfanalikhani.vercel.app

# ---- Blog and admin (runtime only; `npm run build` needs none of these) ----

# PostgreSQL connection string. Neon on Vercel (use the pooled URL with
# ?sslmode=require), the `db` service under Docker Compose (set automatically there).
# Unset: the site works, the blog shows a "not available" message, /admin is off.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional: connection pool size per server instance (default 5).
# DATABASE_POOL_MAX=5

# Admin sign-in. Create the hash with `npm run admin:hash-password`
# (it asks for the password; never put the plain password here).
ADMIN_USERNAME=erfan
ADMIN_PASSWORD_HASH=scrypt:17:8:1:replace-with-the-output-of-the-script

# Signs the admin session cookie: at least 32 random bytes,
# e.g. `openssl rand -base64 48`. Changing it signs every admin out.
SESSION_SECRET=replace-with-a-long-random-string

# Self-hosted only: set to 1 when a reverse proxy in front of the app overwrites
# X-Forwarded-For, so login throttling can count per client IP. Vercel needs nothing.
TRUST_PROXY=0

# Docker Compose only: password of the bundled PostgreSQL (`db` service).
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Optional, self-hosted with several instances or frequent restarts: keeps Server
# Action IDs valid across them (`openssl rand -base64 32`).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
