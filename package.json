    "db:migrate": "node scripts/migrate.mjs",
    "admin:hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/archivo": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vazirmatn": "^33.0.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "type": "module"
